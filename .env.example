# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Target chat/channel id (numeric, or @channelusername for public channels)
TELEGRAM_CHAT_ID=@your_channel

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=sk-ant-your-key
# Model used for summaries. Cheap + fast default.
LLM_MODEL=claude-haiku-4-5-20251001

# --- State backend ---
# STATE_BACKEND=supabase | file  (default: file)
STATE_BACKEND=file
# Only needed when STATE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# --- Behaviour ---
# Max new items processed per run (protects against a flood after downtime)
MAX_ITEMS_PER_RUN=15
# Timezone used for the digest header / "today" wording
DIGEST_TIMEZONE=Europe/Istanbul
# Send a message even when there are no new items (true|false)
SEND_WHEN_EMPTY=false
